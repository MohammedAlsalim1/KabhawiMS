# ==========================================
# 1. أسرار المشروع (الأهم لحماية خادمك 🚨)
# ==========================================
.env
*.env
application-secret.yml
application-secret.properties

# ==========================================
# 2. مجلدات البناء (Maven & Java)
# ==========================================
# نتجاهل مجلدات target في كل الخدمات المصغرة لأن الخادم سيبنيها بنفسه
**/target/
*.class

# نتجاهل الملفات المضغوطة
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# ==========================================
# 3. ملفات بيئة التطوير (IntelliJ IDEA)
# ==========================================
# هذه ملفات خاصة بجهازك ولا يجب رفعها لباقي المطورين أو الخادم
.idea/
*.iml
*.iws
out/
.run/

# ==========================================
# 4. ملفات السجلات (Logs)
# ==========================================
*.log
**/logs/

# ==========================================
# 5. ملفات نظام التشغيل (OS)
# ==========================================
# ملفات مخفية ينشئها الويندوز أو الماك تلقائياً
.DS_Store
Thumbs.db