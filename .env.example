# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL (shared by all service databases)
DB_USER=
DB_PASSWORD=

# pgAdmin
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# Cloudinary (Product-server image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (Order-server confirmation emails)
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
